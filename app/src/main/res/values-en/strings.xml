    <!-- Beta badge and changelog -->
    <string name="app_beta">beta</string>
    <string name="settings_changelog">Changelog</string>
    <string name="settings_changelog_version">Version %1$s</string>
    <string name="changelog_110_fix_photo">Fixed the crash when adding a photo — both from the gallery and from the camera</string>
    <string name="changelog_110_perf">New Performance section: three profiles plus quality, cache and statistics sliders</string>
    <string name="changelog_110_avatars">Avatars: system photo picker without permissions, camera capture, out-of-memory protection for large shots</string>
    <string name="changelog_110_speed">Smoother lists: search moved to a background thread, images load downscaled</string>
    <string name="changelog_110_draft">A new character draft is saved even if you leave the screen right away</string>
    <string name="changelog_110_stability">The floating hint and widget are more reliable: required permissions added and overflow protection</string>
    <string name="changelog_100_first">First public release: library, editor, folders, chat launcher, card import and export, widget</string>

